{
  "name": "reset-radar-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/verify-css-bundle.mjs && node scripts/guard-private-prompts.mjs --build",
    "start": "next start",
    "test": "node --test lib/*.test.ts scripts/*.test.mjs",
    "validate:data": "node scripts/validate-reset-feed.mjs && node scripts/validate-tibo-posts.mjs && node scripts/validate-provider-feeds.mjs && node scripts/validate-side-hustles.mjs && node scripts/guard-private-prompts.mjs",
    "monitor:providers": "node scripts/run-provider-monitor.mjs",
    "monitor:providers:write": "node scripts/run-provider-monitor.mjs --write",
    "review:providers": "node scripts/review-provider-post.mjs",
    "rank:side-hustles": "node scripts/rank-side-hustle-candidates.mjs",
    "notify:side-hustles": "node scripts/report-side-hustle-run.mjs",
    "guard:side-hustles": "node scripts/guard-side-hustle-diff.mjs",
    "ingest:tibo": "node scripts/ingest-tibo-post.mjs",
    "audit:grokbot": "node scripts/report-grokbot-run.mjs",
    "guard:grokbot": "node scripts/guard-grokbot-diff.mjs",
    "provider:readiness": "node scripts/check-local-provider-readiness.mjs",
    "monitor:tibo": "node scripts/run-tibo-monitor.mjs --dry-run",
    "monitor:tibo:write": "node scripts/run-tibo-monitor.mjs --write",
    "monitor:tibo:publish": "node scripts/run-tibo-monitor.mjs --publish",
    "monitor:tibo:install": "node scripts/install-tibo-monitor.mjs",
    "monitor:tibo:uninstall": "node scripts/install-tibo-monitor.mjs --uninstall",
    "monitor:feishu:configure": "node scripts/configure-monitor-feishu.mjs",
    "monitor:feishu:remove": "node scripts/configure-monitor-feishu.mjs --remove",
    "guard:private-prompts": "node scripts/guard-private-prompts.mjs",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react-day-picker": "9.8.1",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
